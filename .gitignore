library/sfx/**/*.wav
library/sfx/**/*.mp3
library/sfx/**/*.ogg
library/sfx/**/*.flac
library/sfx/**/*.m4a

# Your own films and builds
projects/*/*/build/
projects/*/*/out-render*.log
archive/

