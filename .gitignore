# Python env (recreate: docs/setup.md)
.venv/
__pycache__/

# Node / HyperFrames build output
node_modules/
.hyperframes/
renders/
snaps/
probe/
out/
out-render*.log
render.log
tts.log

# Drawing logs and rig-test data (tools/anim_frames.py, tools/rigtest.py)
library/logs/
library/anims/*.log
templates/film/rigtest/lib.js

# Secrets: API keys, OAuth client, YouTube / Facebook tokens. Never commit.
.env
secrets/

# Local runtimes: TTS venvs and voice models (docs/setup.md)
runtime/

# Audio you add to the sound library (keep a note of each file's source and licence)
library/sfx/**/*.wav
library/sfx/**/*.mp3
library/sfx/**/*.ogg
library/sfx/**/*.flac
library/sfx/**/*.m4a

# Your own films and builds
projects/*/*/build/
projects/*/*/out-render*.log
archive/

.DS_Store

# Chapter builds made by shared/chapter_build.py (rebuild them; keep chapter.json and js/scenes*.js)
examples/*/shared/
examples/*/ch*/shared/
examples/*/ch*/assets/
examples/*/ch*/index.html
examples/*/ch*/hyperframes.json
examples/*/ch*/package.json
examples/*/ch*/meta.json
examples/*/ch*/js/data.js
projects/*/*/ch*/shared/
projects/*/*/ch*/assets/
projects/*/*/ch*/index.html
projects/*/*/ch*/js/data.js
# per-paragraph TTS takes (narration.m4a, timing.json and lines.json are kept)
**/audio/*-story/p[0-9][0-9].wav
projects/*/*/shared/
projects/*/*/ch*/hyperframes.json
projects/*/*/ch*/package.json
projects/*/*/ch*/meta.json
