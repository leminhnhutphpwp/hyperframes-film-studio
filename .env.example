# Image backend (tools/imagegen.py): codex | api. Leave empty to pick automatically:
# api when IMAGE_API_KEY is set, otherwise codex when the Codex CLI is installed.
IMAGE_BACKEND=

# codex: nothing to set here. Install the Codex CLI and sign in once (`codex login`).

# api: any OpenAI-compatible Images API (/images/generations and /images/edits).
IMAGE_API_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# Optional: where tools/archive_videos.py moves finished films (default: archive/ in the studio root)
STUDIO_ARCHIVE=

# Optional: Facebook page publishing (publish/facebook/auth.js). Remove FB_USER_TOKEN after the page token is saved.
FB_APP_ID=
FB_APP_SECRET=
FB_USER_TOKEN=
